{
	"name": "amphoreus-heroic-saga",
	"description": "A template for building a React application with Vite, Hono, and Cloudflare Workers",
	"cloudflare": {
		"label": "Vite React Template",
		"products": [
			"Workers"
		],
		"categories": [],
		"preview_icon_url": "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/532a5378-9717-4964-385b-5fafd2160200/public",
		"preview_image_url": "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/ec7f4be5-d1d6-4e94-0851-126341745400/preview",
		"publish": true
	},
	"dependencies": {
		"hono": "4.11.1",
		"motion": "^14.8.0",
		"react": "19.2.1",
		"react-dom": "19.2.1",
		"sityle": "https://github.com/CastoricSi/sityle/releases/download/v1.2.0/sityle-1.2.0.tgz"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "1.52.1",
		"@eslint/js": "9.39.1",
		"@types/node": "24.10.1",
		"@types/react": "19.2.7",
		"@types/react-dom": "19.2.3",
		"@vitejs/plugin-react": "5.1.1",
		"eslint": "9.39.2",
		"eslint-plugin-react-hooks": "7.0.1",
		"eslint-plugin-react-refresh": "0.4.24",
		"globals": "16.5.0",
		"typescript": "5.9.3",
		"typescript-eslint": "8.48.0",
		"vite": "^7.0.0",
		"wrangler": "4.136.1"
	},
	"private": true,
	"scripts": {
		"build": "tsc -b && vite build",
		"cf-typegen": "wrangler types",
		"check": "tsc && vite build && wrangler deploy --dry-run",
		"deploy": "wrangler deploy",
		"dev": "vite",
		"lint": "eslint .",
		"preview": "npm run build && vite preview",
		"editor": "vite --config src/editor/vite.config.ts --open",
		"editor:typecheck": "tsc -p src/editor/tsconfig.json",
		"editor:mission-update": "node src/editor/scripts/mission-sync.js update",
		"editor:mission-reset": "node src/editor/scripts/mission-sync.js reset",
		"editor:test-parser": "node --test src/editor/scripts/sr-wikitext-parser.test.js"
	},
	"type": "module"
}
